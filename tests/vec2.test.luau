local vec = require('../src/shared/core/vec2')
local constants = require('../src/shared/core/constants')
return function(test)
    test('vector arithmetic', function()
        local a, b = vec.new(2, -3), vec.new(4, 5)
        local sum = vec.add(a, b)
        assert(sum.x == 6 and sum.y == 2 and vec.dot(a,b) == -7)
        local scaled = vec.scale(a, 2)
        assert(scaled.x == 4 and scaled.y == -6)
    end)
    test('simulation constants are SI', function()
        assert(constants.gravity == 9.81 and constants.fixedStep == 1/120)
    end)
end
